{
  "name": "opus-racing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev",
    "pages:deploy": "npm run build && wrangler pages deploy",
    "server:deploy": "wrangler deploy --config server/wrangler.toml",
    "deploy": "npm run server:deploy && npm run pages:deploy"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@phosphor-icons/core": "^2.1.1",
    "@types/three": "^0.180.0",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "wrangler": "^4.113.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true
  }
}
