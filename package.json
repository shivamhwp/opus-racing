{
  "name": "opus-racing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "bun run check:tracks && bun run check:physics && bun run check:car && bun run check:world",
    "check:tracks": "bun scripts/check-tracks.mjs",
    "check:physics": "bun scripts/check-physics.mjs",
    "check:car": "bun scripts/check-car.mjs",
    "check:world": "bun scripts/check-world.mjs",
    "icons": "bun scripts/gen-icons.mjs",
    "test:browser": "bun tests/browser.mjs",
    "test:protocol": "bun tests/protocol.mjs",
    "dev:rooms": "wrangler dev --config server/wrangler.toml --port 8798",
    "dev:pages": "wrangler pages dev --port 8799 --do RACE_ROOM=RaceRoom@opus-racing-rooms",
    "deploy:rooms": "wrangler deploy --config server/wrangler.toml",
    "deploy:pages": "bun run build && wrangler pages deploy",
    "deploy": "bun run deploy:rooms && bun run deploy:pages"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@phosphor-icons/core": "^2.1.1",
    "@types/three": "^0.180.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "wrangler": "^4.113.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd",
    "sharp",
    "@cloudflare/workerd-darwin-arm64"
  ]
}
